{
  "name": "auto-nunes-martins",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.15.0",
  "workspaces": [
    "apps/*",
    "backend",
    "shared/*"
  ],
  "scripts": {
    "dev": "yarn workspaces foreach -A -p run dev",
    "dev:crm": "yarn workspace @anm/crm dev",
    "dev:website": "yarn workspace @anm/website dev",
    "build": "yarn workspaces foreach -A run build",
    "lint": "yarn workspaces foreach -A run lint",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "test": "yarn workspaces foreach -A run test",
    "format": "prettier --write \"**/*.{ts,svelte,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,svelte,json,md,css}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*.{ts,svelte,js,jsx,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
