# Public API origin only. Never put Clerk keys, DB URLs or admin tokens here.
PUBLIC_BACKEND_URL=http://localhost:4000
# Set SITE_NOINDEX=true on staging; the combined gateway also protects Render preview hosts.
# SITE_NOINDEX=true

# Private server settings, never PUBLIC_. Same relay secret as backend.
# CONTACT_RELAY_SECRET=
# Enable only after completing publicationReadiness.privacy and confirming actual operations.
CONTACT_PRIVACY_READY=false

# Server-only, set by the combined launcher. Public browser paths stay relative.
# INTERNAL_BACKEND_URL=http://127.0.0.1:4100
