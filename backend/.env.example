# Keep only ONE block active. To switch, comment out the current block,
# uncomment the other, save, and restart the usual development servers.
# Variable names and startup commands stay unchanged.

# ====================================================================
# PRODUCTION - INACTIVE (commented out)
# ====================================================================
# DATABASE_URL=
# DIRECT_URL=
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# SUPABASE_STORAGE_BUCKET=
# CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# CLERK_WEBHOOK_SECRET=

# ====================================================================
# TEST - ACTIVE (local development and testing)
# ====================================================================
DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET="vehicle-photos"
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ====================================================================
# COMMON - ports, logs, contacts and email (defined once)
# ====================================================================
PORT="4000"
NODE_ENV="development"
LOG_LEVEL="info"
FRONTEND_ORIGIN="http://localhost:5174"
CONTACT_ENABLED="false"
# Durable limits for this contact form; provider attempts include failed retries.
CONTACT_DAILY_LIMIT=20
CONTACT_MONTHLY_LIMIT=1000

# CLERK_WEBHOOK_SECRET may be empty; only /webhooks/clerk is disabled.
# CONTACT_RELAY_SECRET=
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=
# CONTACT_TO_EMAIL=
# DB, Storage and Clerk settings belong to the same environment.
