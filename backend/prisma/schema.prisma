generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Users (synced from Clerk via webhook) ───────────────────────────────
model User {
  id            String    @id @default(cuid())
  clerkId       String    @unique
  email         String
  name          String
  /// Profile picture URL mirrored from Clerk on webhook + auto-provision.
  /// Null when the user has not uploaded a custom photo (UI falls back to
  /// red-gradient monogram).
  imageUrl      String?
  /// Terminal local deactivation after a verified Clerk user.deleted event.
  deactivatedAt DateTime?
  role          Role      @default(ADMIN)
  createdAt     DateTime  @default(now())

  tasks                    Task[]                    @relation("assignee")
  contactNotificationsRead ContactNotificationRead[]
  activity                 ActivityLog[]

  @@index([email])
}

/// Records deletion even when the profile has never been provisioned locally.
/// A Clerk identity is terminal: delayed create/update events cannot restore it.
model ClerkUserDeletion {
  clerkId   String   @id
  deletedAt DateTime @default(now())
}

model VehicleBrand {
  name String @id
  key String @unique
  aliases String[] @default([])
  logo String?
  active Boolean @default(true)
  vehicles Vehicle[]
  tradeIns TradeIn[]
}

// ─── Vehicles ────────────────────────────────────────────────────────────
model Vehicle {
  id              String                   @id @default(cuid())
  brand           String
  legacyBrand     String?
  registeredBrand VehicleBrand @relation(fields: [brand], references: [name], onDelete: Restrict, onUpdate: Cascade)
  model           String
  year            Int
  fuel            Fuel
  mileage         Int
  vin             String?                  @unique
  /// Portuguese license plate, stored in canonical "XX-XX-XX" form.
  /// Nullable so legacy rows imported without a registered plate don't break;
  /// unique when set (Postgres allows multiple NULLs in a unique index).
  licensePlate    String?                  @unique
  purchasePrice   Decimal                  @db.Decimal(12, 2)
  salePrice       Decimal?                 @db.Decimal(12, 2)
  status          VehicleStatus            @default(AVAILABLE)
  acquisitionDate DateTime
  soldDate        DateTime?
  description     String?                  @db.Text
  photos          String[]                 @default([])
  photoDimensions VehiclePhotoDimensions[]
  pendingDocFlags Json                     @default("{\"financing\":false,\"imt\":false,\"registration\":false,\"docs\":false}")
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  /// Website approval is independent of CRM availability. Never backfill true.
  webPublished         Boolean             @default(false)
  /// Assigned once at first web publication; retained on unpublish/edit.
  publicSlug           String?             @unique
  publicPrice          Decimal?            @db.Decimal(12, 2)
  publicDescription    String?             @db.Text
  /// Deprecated compatibility mirror. Vehicle.photos follows global web publication; never filter by this field.
  publicPhotoPaths     String[]            @default([])
  publicTransmission   PublicTransmission?
  /// Optional confirmed specifications and equipment approved for public display.
  publicSpecifications Json?

  expenses      VehicleExpense[]
  sale          Sale?            @relation("ActiveSale")
  salesHistory  Sale[]           @relation("SaleHistory")
  /// Set when this vehicle was added to stock as the resulting car of a
  /// customer trade-in. Lets the detail page show acquisition through a trade-in
  /// from the linked sale so staff can track consolidated profit across both
  /// deals. NULL for vehicles purchased the regular way.
  sourceTradeIn TradeIn?         @relation("TradeInToVehicle")

  @@index([status])
  @@index([brand, model])
  @@index([acquisitionDate])
  @@index([webPublished, status])
}

/// Derived metadata only; never grants permission to publish a photograph.
model VehiclePhotoDimensions {
  version    String   @id @db.VarChar(64)
  vehicleId  String
  width      Int
  height     Int
  sourceHash String   @db.VarChar(64)
  createdAt  DateTime @default(now())
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

enum PublicTransmission {
  MANUAL
  AUTOMATIC
}

model VehicleExpense {
  id          String                 @id @default(cuid())
  vehicleId   String
  category    VehicleExpenseCategory
  description String
  amount      Decimal                @db.Decimal(12, 2)
  date        DateTime
  createdAt   DateTime               @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

// ─── Customers ───────────────────────────────────────────────────────────
model Customer {
  id              String    @id @default(cuid())
  name            String
  phone           String
  email           String?
  address         String?
  nif             String    @unique
  notes           String?   @db.Text
  lastContactDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sales Sale[]

  @@index([name])
}

// ─── Sales ───────────────────────────────────────────────────────────────
model Sale {
  id                   String         @id @default(cuid())
  /// Unique link to the active sale; released on cancellation.
  vehicleId            String?        @unique
  originalVehicleId    String
  cancelledAt          DateTime?
  cancelledBy          String?
  cancellationReason   String?        @db.Text
  cancellationDecision Json?
  customerId           String
  salePrice            Decimal        @db.Decimal(12, 2)
  vatAmount            Decimal        @db.Decimal(12, 2)
  /// Manual extra income captured per-sale: typically a referral commission
  /// paid by a credit institution when the customer financed the purchase
  /// through them. Folded into `realProfit` so the dashboard KPI and the
  /// "Lucro por viatura" view automatically include it.
  commission           Decimal        @default(0) @db.Decimal(12, 2)
  /// Buyer type for VAT. PARTICULAR uses the margin scheme;
  /// 23/123 is paid from the dealer margin. COMERCIANTE is a B2B sale
  /// without itemized VAT, so the full margin is profit. The default
  /// preserves the original behavior of existing sales.
  buyerType            BuyerType      @default(PARTICULAR)
  realProfit           Decimal        @db.Decimal(12, 2)
  saleDate             DateTime
  deliveryDate         DateTime?
  deliveryStatus       DeliveryStatus @default(PENDING)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  activeVehicle Vehicle? @relation("ActiveSale", fields: [vehicleId], references: [id], onDelete: Restrict)
  vehicle       Vehicle  @relation("SaleHistory", fields: [originalVehicleId], references: [id])
  customer      Customer @relation(fields: [customerId], references: [id])
  tradeIn       TradeIn?

  @@index([saleDate])
  @@index([customerId])
  @@index([originalVehicleId])
  @@index([cancelledAt, saleDate])
}

// ─── Trade-ins ───────────────────────────────────────────────────────────
// A car handed over by the customer as partial payment for the vehicle they
// are buying. Always tied to exactly one Sale (1:1) — never exists standalone.
// `disposition = STOCK` creates a new Vehicle row at sale-creation time, which
// is linked back via `resultingVehicleId`. `disposition = SCRAP` skips the
// stock entry (car goes to scrap / dismantler / B2B auction) while still
// recording the deal context and the allowance abated from the sale price.
model TradeIn {
  id     String @id @default(cuid())
  saleId String @unique
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Restrict)

  // Minimal vehicle identification — enough for the receipt and to seed a
  // future Vehicle row if the car goes to stock.
  brand        String
  legacyBrand String?
  registeredBrand VehicleBrand @relation(fields: [brand], references: [name], onDelete: Restrict, onUpdate: Cascade)
  model        String
  year         Int
  fuel         Fuel
  mileage      Int
  licensePlate String?
  vin          String?

  /// Allowance attributed to the trade-in. Subtracted from `Sale.salePrice`
  /// before margin/VAT is computed (PT margin scheme cares about the *net*
  /// the dealer effectively received in cash).
  allowanceValue Decimal @db.Decimal(12, 2)

  disposition        TradeInDisposition
  resultingVehicleId String?            @unique
  resultingVehicle   Vehicle?           @relation("TradeInToVehicle", fields: [resultingVehicleId], references: [id], onDelete: Restrict)

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Tasks ───────────────────────────────────────────────────────────────
model Task {
  id                 String     @id @default(cuid())
  title              String
  description        String?    @db.Text
  status             TaskStatus @default(TODO)
  priority           Priority   @default(MEDIUM)
  assigneeId         String?
  startDate          DateTime?
  dueDate            DateTime?
  reminderDate       DateTime?
  recurrence         Recurrence @default(NONE)
  recurrenceParentId String?
  /// Set when status transitions to DONE; cleared when status moves away.
  /// Weekly cleanup removes DONE tasks completed before the latest Sunday.
  completedAt        DateTime?
  /// Shared board order within status; visibility remains own + unassigned tasks.
  boardPosition      Decimal    @default(0) @db.Decimal(30, 12)
  /// Optimistic concurrency for moves; independent of technical rank compaction.
  boardVersion       Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  assignee         User?  @relation("assignee", fields: [assigneeId], references: [id])
  recurrenceParent Task?  @relation("recurrence", fields: [recurrenceParentId], references: [id], onDelete: SetNull)
  children         Task[] @relation("recurrence")

  @@index([status, priority])
  @@index([assigneeId])
  @@index([dueDate])
  @@index([status, completedAt]) // fast purge of stale DONE tasks
  @@index([status, boardPosition])
}

// ─── Operational Expenses (dealership overhead) ──────────────────────────
model OperationalExpense {
  id          String            @id @default(cuid())
  category    OpExpenseCategory
  description String
  amount      Decimal           @db.Decimal(12, 2)
  date        DateTime
  createdAt   DateTime          @default(now())

  @@index([date])
  @@index([category])
}

// ─── Audit log for "Recent Activity" feed ───────────────────────────────
model ActivityLog {
  id         String       @id @default(cuid())
  actorId    String?
  type       ActivityType
  entityType String
  entityId   String
  message    String
  metadata   Json?
  createdAt  DateTime     @default(now())

  actor        User?                     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  contactReads ContactNotificationRead[]

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([type, createdAt(sort: Desc)])
}

// ─── Admin-editable settings (alert thresholds, etc) ─────────────────────
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─── Enums ───────────────────────────────────────────────────────────────
enum Role {
  ADMIN
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  SOLD
  DELIVERED
  DOCS_PENDING
  /// Draft vehicle: present in inventory but not yet available for sale
  /// because pricing or photos are missing. Typically created when a
  /// STOCK trade-in arrives; publishVehicle() changes it from DRAFT
  /// once the dealer supplies the final price and description.
  DRAFT
  /// Returned trade-in: historical record outside current stock.
  RETURNED
}

enum Fuel {
  GASOLINE
  DIESEL
  HYBRID
  PLUGIN_HYBRID
  ELECTRIC
  LPG
}

enum VehicleExpenseCategory {
  ACQUISITION
  REPAIR
  INSPECTION
  TRANSPORT
  CLEANING
  DOCS
  OTHER
}

enum OpExpenseCategory {
  RENT
  BILLS
  SERVICES
  OTHER
}

enum DeliveryStatus {
  PENDING
  SCHEDULED
  DELIVERED
}

enum BuyerType {
  PARTICULAR
  COMERCIANTE
}

enum TradeInDisposition {
  STOCK // resulted in a new Vehicle row added to inventory
  SCRAP // car went to scrap / dismantler / auction — no inventory entry
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Recurrence {
  NONE
  WEEKLY
  MONTHLY
  ANNUAL
}

enum ActivityType {
  CONTACT_REQUEST_RECEIVED
  VEHICLE_ADDED
  VEHICLE_UPDATED
  VEHICLE_STATUS_CHANGED
  VEHICLE_DELETED
  SALE_CREATED
  SALE_UPDATED
  TRADE_IN_RECEIVED
  CUSTOMER_ADDED
  CUSTOMER_UPDATED
  TASK_CREATED
  TASK_STATUS_CHANGED
  TASK_COMPLETED
  EXPENSE_ADDED
  EXPENSE_UPDATED
}

// Private contact budgets and idempotency metadata; never store message content.
model ContactBudgetCounter {
  key       String   @id @db.VarChar(80)
  count     Int
  expiresAt DateTime @db.Timestamptz(6)

  @@index([expiresAt])
}

model ContactSendAttempt {
  key         String   @id @db.VarChar(64)
  payloadHash String   @db.VarChar(64)
  status      String   @db.VarChar(8)
  firstAt     DateTime @db.Timestamptz(6)
  leaseUntil  DateTime @db.Timestamptz(6)
  expiresAt   DateTime @db.Timestamptz(6)
  token       Int

  @@index([expiresAt])
}

model ContactNotificationRead {
  eventId String
  userId  String
  readAt  DateTime    @default(now()) @db.Timestamptz(6)
  event   ActivityLog @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
}
