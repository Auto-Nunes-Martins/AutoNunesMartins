generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Users (synced from Clerk via webhook) ───────────────────────────────
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String
  /// Profile picture URL mirrored from Clerk on webhook + auto-provision.
  /// Null when the user has not uploaded a custom photo (UI falls back to
  /// red-gradient monogram).
  imageUrl  String?
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())

  tasks    Task[]        @relation("assignee")
  activity ActivityLog[]
}

// ─── Vehicles ────────────────────────────────────────────────────────────
model Vehicle {
  id              String        @id @default(cuid())
  brand           String
  model           String
  year            Int
  fuel            Fuel
  mileage         Int
  vin             String        @unique
  /// Portuguese license plate (matrícula), stored canonical as "XX-XX-XX".
  /// Nullable so legacy rows imported without a registered plate don't break;
  /// unique when set (Postgres allows multiple NULLs in a unique index).
  licensePlate    String?       @unique
  purchasePrice   Decimal       @db.Decimal(12, 2)
  salePrice       Decimal?      @db.Decimal(12, 2)
  status          VehicleStatus @default(AVAILABLE)
  acquisitionDate DateTime
  soldDate        DateTime?
  description     String?       @db.Text
  photos          String[]      @default([])
  pendingDocFlags Json          @default("{\"financing\":false,\"imt\":false,\"registration\":false,\"docs\":false}")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  /// Website approval is independent of CRM availability. Never backfill true.
  webPublished       Boolean              @default(false)
  /// Assigned once at first web publication; retained on unpublish/edit.
  publicSlug         String?              @unique
  publicPrice        Decimal?             @db.Decimal(12, 2)
  publicDescription  String?              @db.Text
  /// Explicitly approved subset of this vehicle's private storage photos.
  publicPhotoPaths   String[]             @default([])
  publicTransmission PublicTransmission?

  expenses VehicleExpense[]
  sale     Sale?
  /// Set when this vehicle was added to stock as the resulting car of a
  /// customer trade-in. Lets the detail page surface "Adquirido como retoma
  /// da venda X" so the dealer can follow consolidated profit across both
  /// deals. NULL for vehicles purchased the regular way.
  sourceTradeIn TradeIn? @relation("TradeInToVehicle")

  @@index([status])
  @@index([brand, model])
  @@index([acquisitionDate])
  @@index([webPublished, status])
}

enum PublicTransmission {
  MANUAL
  AUTOMATIC
}

model VehicleExpense {
  id          String                 @id @default(cuid())
  vehicleId   String
  category    VehicleExpenseCategory
  description String
  amount      Decimal                @db.Decimal(12, 2)
  date        DateTime
  createdAt   DateTime               @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

// ─── Customers ───────────────────────────────────────────────────────────
model Customer {
  id              String    @id @default(cuid())
  name            String
  phone           String
  email           String?
  address         String?
  nif             String    @unique
  notes           String?   @db.Text
  lastContactDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sales Sale[]

  @@index([name])
}

// ─── Sales ───────────────────────────────────────────────────────────────
model Sale {
  id             String         @id @default(cuid())
  vehicleId      String         @unique
  customerId     String
  salePrice      Decimal        @db.Decimal(12, 2)
  vatAmount      Decimal        @db.Decimal(12, 2)
  /// Manual extra income captured per-sale: typically a referral commission
  /// paid by a credit institution when the customer financed the purchase
  /// through them. Folded into `realProfit` so the dashboard KPI and the
  /// "Lucro por viatura" view automatically include it.
  commission     Decimal        @default(0) @db.Decimal(12, 2)
  /// Tipo de comprador para efeitos de IVA. PARTICULAR → regime de margem
  /// 23/123 (IVA sai do bolso do stand). COMERCIANTE → venda B2B sem IVA
  /// discriminado (margem inteira fica como lucro). Default mantém o
  /// comportamento original para vendas existentes.
  buyerType      BuyerType      @default(PARTICULAR)
  realProfit     Decimal        @db.Decimal(12, 2)
  saleDate       DateTime
  deliveryDate   DateTime?
  deliveryStatus DeliveryStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  tradeIn  TradeIn?

  @@index([saleDate])
  @@index([customerId])
}

// ─── Trade-ins ───────────────────────────────────────────────────────────
// A car handed over by the customer as partial payment for the vehicle they
// are buying. Always tied to exactly one Sale (1:1) — never exists standalone.
// `disposition = STOCK` creates a new Vehicle row at sale-creation time, which
// is linked back via `resultingVehicleId`. `disposition = SCRAP` skips the
// stock entry (car goes to scrap / dismantler / B2B auction) while still
// recording the deal context and the allowance abated from the sale price.
model TradeIn {
  id     String @id @default(cuid())
  saleId String @unique
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  // Minimal vehicle identification — enough for the receipt and to seed a
  // future Vehicle row if the car goes to stock.
  brand        String
  model        String
  year         Int
  fuel         Fuel
  mileage      Int
  licensePlate String?
  vin          String?

  /// Allowance attributed to the trade-in. Subtracted from `Sale.salePrice`
  /// before margin/VAT is computed (PT margin scheme cares about the *net*
  /// the dealer effectively received in cash).
  allowanceValue Decimal @db.Decimal(12, 2)

  disposition        TradeInDisposition
  resultingVehicleId String?            @unique
  resultingVehicle   Vehicle?           @relation("TradeInToVehicle", fields: [resultingVehicleId], references: [id])

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Tasks ───────────────────────────────────────────────────────────────
model Task {
  id                 String     @id @default(cuid())
  title              String
  description        String?    @db.Text
  status             TaskStatus @default(TODO)
  priority           Priority   @default(MEDIUM)
  assigneeId         String?
  startDate          DateTime?
  dueDate            DateTime?
  reminderDate       DateTime?
  recurrence         Recurrence @default(NONE)
  recurrenceParentId String?
  /// Set when status transitions to DONE; cleared when status moves away.
  /// Used to auto-purge completed tasks after AppSetting.doneTaskRetentionDays.
  completedAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  assignee         User?  @relation("assignee", fields: [assigneeId], references: [id])
  recurrenceParent Task?  @relation("recurrence", fields: [recurrenceParentId], references: [id], onDelete: SetNull)
  children         Task[] @relation("recurrence")

  @@index([status, priority])
  @@index([assigneeId])
  @@index([dueDate])
  @@index([status, completedAt]) // fast purge of stale DONE tasks
}

// ─── Operational Expenses (dealership overhead) ──────────────────────────
model OperationalExpense {
  id          String            @id @default(cuid())
  category    OpExpenseCategory
  description String
  amount      Decimal           @db.Decimal(12, 2)
  date        DateTime
  createdAt   DateTime          @default(now())

  @@index([date])
  @@index([category])
}

// ─── Audit log for "Recent Activity" feed ───────────────────────────────
model ActivityLog {
  id         String       @id @default(cuid())
  actorId    String?
  type       ActivityType
  entityType String
  entityId   String
  message    String
  metadata   Json?
  createdAt  DateTime     @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
}

// ─── Admin-editable settings (alert thresholds, etc) ─────────────────────
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─── Enums ───────────────────────────────────────────────────────────────
enum Role {
  ADMIN
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  SOLD
  DELIVERED
  DOCS_PENDING
  /// "Rascunho" — viatura existe no inventário mas ainda não está publicada
  /// para venda (preço por definir, fotos por carregar, etc.). Típicamente
  /// criado quando entra uma retoma STOCK; sai de DRAFT via publishVehicle()
  /// quando o dono do stand decide o preço final e descrição.
  DRAFT
}

enum Fuel {
  GASOLINE
  DIESEL
  HYBRID
  PLUGIN_HYBRID
  ELECTRIC
  LPG
}

enum VehicleExpenseCategory {
  ACQUISITION
  REPAIR
  INSPECTION
  TRANSPORT
  CLEANING
  DOCS
  OTHER
}

enum OpExpenseCategory {
  RENT
  BILLS
  SERVICES
  OTHER
}

enum DeliveryStatus {
  PENDING
  SCHEDULED
  DELIVERED
}

enum BuyerType {
  PARTICULAR
  COMERCIANTE
}

enum TradeInDisposition {
  STOCK // resulted in a new Vehicle row added to inventory
  SCRAP // car went to scrap / dismantler / auction — no inventory entry
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Recurrence {
  NONE
  WEEKLY
  MONTHLY
  ANNUAL
}

enum ActivityType {
  VEHICLE_ADDED
  VEHICLE_UPDATED
  VEHICLE_STATUS_CHANGED
  VEHICLE_DELETED
  SALE_CREATED
  SALE_UPDATED
  TRADE_IN_RECEIVED
  CUSTOMER_ADDED
  CUSTOMER_UPDATED
  TASK_CREATED
  TASK_STATUS_CHANGED
  TASK_COMPLETED
  EXPENSE_ADDED
  EXPENSE_UPDATED
}
