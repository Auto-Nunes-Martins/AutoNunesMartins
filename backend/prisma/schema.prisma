generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Users (synced from Clerk via webhook) ───────────────────────────────
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())

  tasks    Task[]        @relation("assignee")
  activity ActivityLog[]
}

// ─── Vehicles ────────────────────────────────────────────────────────────
model Vehicle {
  id              String        @id @default(cuid())
  brand           String
  model           String
  year            Int
  fuel            Fuel
  mileage         Int
  vin             String        @unique
  /// Portuguese license plate (matrícula), stored canonical as "XX-XX-XX".
  /// Nullable so legacy rows imported without a registered plate don't break;
  /// unique when set (Postgres allows multiple NULLs in a unique index).
  licensePlate    String?       @unique
  purchasePrice   Decimal       @db.Decimal(12, 2)
  salePrice       Decimal?      @db.Decimal(12, 2)
  status          VehicleStatus @default(AVAILABLE)
  acquisitionDate DateTime
  soldDate        DateTime?
  description     String?       @db.Text
  photos          String[]      @default([])
  pendingDocFlags Json          @default("{\"financing\":false,\"imt\":false,\"registration\":false,\"docs\":false}")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  expenses VehicleExpense[]
  sale     Sale?

  @@index([status])
  @@index([brand, model])
  @@index([acquisitionDate])
}

model VehicleExpense {
  id          String                 @id @default(cuid())
  vehicleId   String
  category    VehicleExpenseCategory
  description String
  amount      Decimal                @db.Decimal(12, 2)
  date        DateTime
  createdAt   DateTime               @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

// ─── Customers ───────────────────────────────────────────────────────────
model Customer {
  id              String    @id @default(cuid())
  name            String
  phone           String
  email           String?
  address         String?
  nif             String    @unique
  notes           String?   @db.Text
  lastContactDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sales Sale[]

  @@index([name])
}

// ─── Sales ───────────────────────────────────────────────────────────────
model Sale {
  id             String         @id @default(cuid())
  vehicleId      String         @unique
  customerId     String
  salePrice      Decimal        @db.Decimal(12, 2)
  vatAmount      Decimal        @db.Decimal(12, 2)
  /// Manual extra income captured per-sale: typically a referral commission
  /// paid by a credit institution when the customer financed the purchase
  /// through them. Folded into `realProfit` so the dashboard KPI and the
  /// "Lucro por viatura" view automatically include it.
  commission     Decimal        @default(0) @db.Decimal(12, 2)
  realProfit     Decimal        @db.Decimal(12, 2)
  saleDate       DateTime
  deliveryDate   DateTime?
  deliveryStatus DeliveryStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([saleDate])
  @@index([customerId])
}

// ─── Tasks ───────────────────────────────────────────────────────────────
model Task {
  id                 String     @id @default(cuid())
  title              String
  description        String?    @db.Text
  status             TaskStatus @default(TODO)
  priority           Priority   @default(MEDIUM)
  assigneeId         String?
  startDate          DateTime?
  dueDate            DateTime?
  reminderDate       DateTime?
  recurrence         Recurrence @default(NONE)
  recurrenceParentId String?
  /// Set when status transitions to DONE; cleared when status moves away.
  /// Used to auto-purge completed tasks after AppSetting.doneTaskRetentionDays.
  completedAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  assignee         User?  @relation("assignee", fields: [assigneeId], references: [id])
  recurrenceParent Task?  @relation("recurrence", fields: [recurrenceParentId], references: [id], onDelete: SetNull)
  children         Task[] @relation("recurrence")

  @@index([status, priority])
  @@index([assigneeId])
  @@index([dueDate])
  @@index([status, completedAt]) // fast purge of stale DONE tasks
}

// ─── Operational Expenses (dealership overhead) ──────────────────────────
model OperationalExpense {
  id          String            @id @default(cuid())
  category    OpExpenseCategory
  description String
  amount      Decimal           @db.Decimal(12, 2)
  date        DateTime
  createdAt   DateTime          @default(now())

  @@index([date])
  @@index([category])
}

// ─── Audit log for "Recent Activity" feed ───────────────────────────────
model ActivityLog {
  id         String       @id @default(cuid())
  actorId    String?
  type       ActivityType
  entityType String
  entityId   String
  message    String
  metadata   Json?
  createdAt  DateTime     @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
}

// ─── Admin-editable settings (alert thresholds, etc) ─────────────────────
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─── Enums ───────────────────────────────────────────────────────────────
enum Role {
  ADMIN
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  SOLD
  DELIVERED
  DOCS_PENDING
}

enum Fuel {
  GASOLINE
  DIESEL
  HYBRID
  PLUGIN_HYBRID
  ELECTRIC
  LPG
}

enum VehicleExpenseCategory {
  ACQUISITION
  REPAIR
  INSPECTION
  TRANSPORT
  CLEANING
  DOCS
  OTHER
}

enum OpExpenseCategory {
  RENT
  BILLS
  SERVICES
  OTHER
}

enum DeliveryStatus {
  PENDING
  SCHEDULED
  DELIVERED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Recurrence {
  NONE
  MONTHLY
  ANNUAL
}

enum ActivityType {
  VEHICLE_ADDED
  VEHICLE_UPDATED
  VEHICLE_STATUS_CHANGED
  VEHICLE_DELETED
  SALE_CREATED
  SALE_UPDATED
  CUSTOMER_ADDED
  CUSTOMER_UPDATED
  TASK_CREATED
  TASK_STATUS_CHANGED
  TASK_COMPLETED
  EXPENSE_ADDED
  EXPENSE_UPDATED
}
